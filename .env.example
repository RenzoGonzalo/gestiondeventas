# Backend environment variables (copy to .env locally)

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
JWT_SECRET=change-me

# Optional but recommended (Prisma)
# If you don't have a separate direct connection, you can set it equal to DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# CORS
# Comma-separated list of allowed origins.
# Example: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Base URL of this backend (used to build email verification links)
# Example: http://localhost:4000 or https://your-api.example.com
BACKEND_URL=http://localhost:4000

# Frontend URL used for email verification redirect (optional)
FRONTEND_URL=http://localhost:5173

# Google (STORE_ADMIN login)
GOOGLE_CLIENT_ID=

# Email (used for SUPER_ADMIN verification email when using Gmail SMTP)
# For Gmail you likely need an App Password.
EMAIL_USER=
EMAIL_PASS=

# Optional providers (if you switch away from Gmail SMTP)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
